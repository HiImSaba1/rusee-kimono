# Redacted production template only. Configure real values in the private Plesk
# environment; never upload or commit a populated copy of this file.
NODE_ENV="production"
DATABASE_URL="mysql://RUSEE_DB_USER:URL_ENCODED_PASSWORD@127.0.0.1:3306/next_rusee"

# Temporary owner bootstrap values. Remove them from Plesk after the intended
# production owner has been created or synchronized through the reviewed flow.
ADMIN_BOOTSTRAP_USERNAME="RUSEE_OWNER_USERNAME"
ADMIN_BOOTSTRAP_PASSWORD="GENERATE_A_UNIQUE_TEMPORARY_PASSWORD"
ADMIN_SESSION_SECRET="GENERATE_AT_LEAST_32_RANDOM_CHARACTERS"
AUTOMATION_SECRET="GENERATE_A_DIFFERENT_32_CHARACTER_SECRET"

APP_URL="https://RUSEE_PRODUCTION_DOMAIN"
PAYMENTS_DEFAULT_PROVIDER="fake"
ENABLE_FAKE_PAYMENTS="false"
MAINTENANCE_MODE="false"

# Non-secret launch approvals remain false until the responsible owner or
# professional has supplied and reviewed the corresponding evidence.
LAUNCH_HOSTING_APPROVED="false"
LAUNCH_EMAIL_DNS_APPROVED="false"
LAUNCH_TAX_SHIPPING_APPROVED="false"
LAUNCH_LEGAL_APPROVED="false"
LAUNCH_PRODUCT_DATA_APPROVED="false"
LAUNCH_FULFILMENT_APPROVED="false"
LAUNCH_IMPORTED_HISTORY_REVIEWED="false"
LAUNCH_PAYMENT_PROVIDER_APPROVED="false"

# Confirm the Rusee mailbox host and recipients in Papaki. Do not reuse another
# project's mailbox, username, password, or recipient addresses.
SMTP_HOST="RUSEE_SMTP_HOST"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER="RUSEE_SMTP_USERNAME"
SMTP_PASSWORD="RUSEE_SMTP_PASSWORD"
MAIL_FROM="Rusee <RUSEE_SMTP_USERNAME>"
ADMIN_ORDER_EMAIL="RUSEE_APPROVED_ORDER_RECIPIENT"
CONTACT_STUDIO_EMAIL="RUSEE_APPROVED_CONTACT_RECIPIENT"

PRIVACY_RETENTION_ENABLED="false"
PRIVACY_CONTACT_RETENTION_DAYS="REVIEW_WITH_APPROVED_POLICY"
ALERT_WEBHOOK_URL=""
MONITOR_ALERT_COOLDOWN_MINUTES="30"
