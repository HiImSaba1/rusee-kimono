# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/artifacts/

# project-local tools
/.tools/

# next.js
/.next/
/.next-playwright/
/.next-performance/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
results.txt

# env files (can opt-in for committing if needed)
.env*
!.env.example
!.env.production.example

# sensitive local database snapshots
/next_kimono.sql

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
