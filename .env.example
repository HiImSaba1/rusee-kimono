# Local MySQL/MariaDB connection. URL-encode special characters in credentials.
DATABASE_URL="mysql://next_kimono_app:CHANGE_ME@localhost:3306/next_kimono"

# Temporary first-admin bootstrap values. Remove/disable bootstrap behavior after
# the first password hash is stored in the database.
ADMIN_BOOTSTRAP_USERNAME="admin"
ADMIN_BOOTSTRAP_PASSWORD="CHANGE_ME"
ADMIN_SESSION_SECRET="CHANGE_ME_TO_A_LONG_RANDOM_VALUE"

APP_URL="http://localhost:3000"
PAYMENTS_DEFAULT_PROVIDER="fake"
ENABLE_FAKE_PAYMENTS="false"

# Papaki email: use smtp-gr.securemail.pro:465 with TLS for the current mail
# platform, or the temporary linuxNN.papaki.gr hostname supplied for older hosting.
SMTP_HOST="smtp-gr.securemail.pro"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER="orders@example.gr"
SMTP_PASSWORD="CHANGE_ME"
MAIL_FROM="Ruseè <orders@example.gr>"
ADMIN_ORDER_EMAIL="studio@example.gr"
CONTACT_STUDIO_EMAIL="studio@example.gr"
PRIVACY_RETENTION_ENABLED="false"
PRIVACY_CONTACT_RETENTION_DAYS="365"
ALERT_WEBHOOK_URL=""
MONITOR_ALERT_COOLDOWN_MINUTES="30"
AUTOMATION_SECRET="CHANGE_ME_TO_A_SEPARATE_RANDOM_VALUE_OF_AT_LEAST_32_CHARACTERS"

