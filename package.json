{
  "name": "kimono-shop",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:local": "next dev --port 3000",
    "dev:test": "set \"NEXT_DIST_DIR=.next-playwright\" && next dev --hostname 127.0.0.1 --port 3107",
    "build": "next build",
    "build:plesk": "next build --webpack && node scripts/prepare-standalone.mjs",
    "start": "next start",
    "start:cpanel": "node scripts/cpanel-start.cjs",
    "start:plesk": "node scripts/plesk-start.cjs",
    "lint": "eslint",
    "test": "node --env-file=.env node_modules/vitest/vitest.mjs run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:info": "node --env-file=.env scripts/database-info.mjs",
    "db:info:production:private": "node --env-file=.env.production.local scripts/database-info.mjs",
    "db:seed": "node --env-file=.env scripts/seed.mjs",
    "content:initialize": "node --env-file=.env scripts/seed-information-pages.mjs",
    "content:initialize:production": "node scripts/seed-information-pages.mjs",
    "content:initialize:production:private": "node --env-file=.env.production.local scripts/seed-information-pages.mjs",
    "catalogue:sync:production:private": "node --env-file=.env.production.local scripts/assign-optimized-kimono-images.mjs",
    "db:release-reservations": "node --env-file=.env scripts/release-expired-reservations.mjs",
    "db:release-reservations:production": "node scripts/release-expired-reservations.mjs",
    "monitor:health": "node --env-file=.env scripts/monitor-health.mjs",
    "monitor:health:production": "node scripts/monitor-health.mjs",
    "monitor:site:production:private": "node --env-file=.env.production.local scripts/check-production-site.mjs",
    "production:preflight": "node scripts/production-preflight.mjs",
    "production:preflight:private": "node --env-file=.env.production.local scripts/production-preflight.mjs",
    "production:permissions:repair": "node scripts/repair-release-permissions.mjs",
    "production:standalone:prepare": "node scripts/prepare-standalone.mjs",
    "db:migrate:production:private": "node --env-file=.env.production.local scripts/migrate-database.mjs",
    "admin:bootstrap": "node --env-file=.env scripts/bootstrap-admin.mjs",
    "admin:bootstrap:production:private": "node --env-file=.env.production.local scripts/bootstrap-admin.mjs"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@gsap/react": "^2.1.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "gsap": "^3.15.0",
    "lenis": "^1.3.25",
    "lucide-react": "^1.27.0",
    "motion": "^12.42.2",
    "mysql2": "^3.23.1",
    "next": "16.2.12",
    "nodemailer": "^9.0.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "server-only": "^0.0.1",
    "sharp": "^0.34.5",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.2",
    "@playwright/test": "1.55.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "playwright-core": "1.55.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
